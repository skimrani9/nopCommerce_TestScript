<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.nopcommerce</groupId>
    <artifactId>ui-automation</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <name>nopCommerce UI Automation</name>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>21</maven.compiler.release>
        <selenium.version>4.27.0</selenium.version>
        <cucumber.version>7.20.1</cucumber.version>
        <testng.version>7.10.2</testng.version>
        <webdrivermanager.version>5.9.2</webdrivermanager.version>
        <assertj.version>3.26.3</assertj.version>
        <log4j.version>2.24.3</log4j.version>
        <extent.version>1.14.0</extent.version>
        <javafaker.version>1.0.2</javafaker.version>
        <environment>local</environment>
        <base.url>http://localhost</base.url>
        <cucumber.tags>@admin and not @wip</cucumber.tags>
        <maven.test.failure.ignore>false</maven.test.failure.ignore>
        <coverage.enabled>false</coverage.enabled>
        <coverage.api.baseUrl>http://127.0.0.1:5055</coverage.api.baseUrl>
        <coverage.failOnMissingTcEnd>true</coverage.failOnMissingTcEnd>
        <coverage.session.id></coverage.session.id>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.seleniumhq.selenium</groupId>
            <artifactId>selenium-java</artifactId>
            <version>${selenium.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.bonigarcia</groupId>
            <artifactId>webdrivermanager</artifactId>
            <version>${webdrivermanager.version}</version>
        </dependency>
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-java</artifactId>
            <version>${cucumber.version}</version>
        </dependency>
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-testng</artifactId>
            <version>${cucumber.version}</version>
        </dependency>
        <dependency>
            <groupId>org.testng</groupId>
            <artifactId>testng</artifactId>
            <version>${testng.version}</version>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>${assertj.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-api</artifactId>
            <version>${log4j.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
            <version>${log4j.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-slf4j2-impl</artifactId>
            <version>${log4j.version}</version>
        </dependency>
        <dependency>
            <groupId>tech.grasshopper</groupId>
            <artifactId>extentreports-cucumber7-adapter</artifactId>
            <version>${extent.version}</version>
        </dependency>
        <dependency>
            <groupId>com.github.javafaker</groupId>
            <artifactId>javafaker</artifactId>
            <version>${javafaker.version}</version>
        </dependency>
        <dependency>
            <groupId>commons-io</groupId>
            <artifactId>commons-io</artifactId>
            <version>2.18.0</version>
        </dependency>
        <dependency>
            <groupId>dev.samstevens.totp</groupId>
            <artifactId>totp</artifactId>
            <version>1.7.1</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
                <configuration>
                    <includes>
                        <include>**/*TestRunner.java</include>
                    </includes>
                    <testFailureIgnore>${maven.test.failure.ignore}</testFailureIgnore>
                    <systemPropertyVariables>
                        <environment>${environment}</environment>
                        <base.url>${base.url}</base.url>
                        <cucumber.filter.tags>${cucumber.tags}</cucumber.filter.tags>
                        <coverage.enabled>${coverage.enabled}</coverage.enabled>
                        <coverage.api.baseUrl>${coverage.api.baseUrl}</coverage.api.baseUrl>
                        <coverage.failOnMissingTcEnd>${coverage.failOnMissingTcEnd}</coverage.failOnMissingTcEnd>
                        <coverage.session.id>${coverage.session.id}</coverage.session.id>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>admin-all</id>
            <properties>
                <cucumber.tags>@admin and not @wip</cucumber.tags>
                <maven.test.failure.ignore>true</maven.test.failure.ignore>
            </properties>
        </profile>
        <profile>
            <id>coverage</id>
            <properties>
                <coverage.enabled>true</coverage.enabled>
                <coverage.api.baseUrl>http://127.0.0.1:5055</coverage.api.baseUrl>
            </properties>
        </profile>
        <profile>
            <id>admin-all-coverage</id>
            <properties>
                <cucumber.tags>@admin and not @wip</cucumber.tags>
                <maven.test.failure.ignore>true</maven.test.failure.ignore>
                <base.url>http://localhost:5000</base.url>
                <coverage.enabled>true</coverage.enabled>
                <coverage.api.baseUrl>http://127.0.0.1:5055</coverage.api.baseUrl>
                <coverage.failOnMissingTcEnd>false</coverage.failOnMissingTcEnd>
            </properties>
        </profile>
    </profiles>
</project>
